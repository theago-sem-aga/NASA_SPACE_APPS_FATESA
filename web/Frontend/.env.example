# Fonte dos dados exibidos no front.
# mock = dados fictícios de src/api/mock (rotulados na tela como demonstração)
# api  = backend FastAPI (ainda não implementado)
VITE_FONTE_DADOS=mock

# true = mostra avisos de "dados de exemplo" na tela quando usa mock.
# Padrão desligado (para avaliar o visual final). Ligue em apresentações com mock.
VITE_SINALIZAR_MOCK=false

# URL base da API, usada quando VITE_FONTE_DADOS=api
VITE_API_URL=http://localhost:8000/api/v1
