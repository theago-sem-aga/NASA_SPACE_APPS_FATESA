  "components": {
    "schemas": {
      "Analise": {
        "properties": {
          "analise_id": {
            "type": "string",
            "title": "Analise Id"
          },
          "eh_mock": {
            "type": "boolean",
            "title": "Eh Mock"
          },
          "descricao_local": {
            "type": "string",
            "title": "Descricao Local"
          },
          "talhao": {
            "$ref": "#/components/schemas/CaracteristicasTalhao"
          },
          "fonte_clima": {
            "$ref": "#/components/schemas/FonteClima"
          },
          "clima_mensal": {
            "items": {
              "$ref": "#/components/schemas/ClimaMensal"
            },
            "type": "array",
            "title": "Clima Mensal"
          },
          "estrategias": {
            "items": {
              "$ref": "#/components/schemas/Estrategia"
            },
            "type": "array",
            "title": "Estrategias"
          },
          "limitacoes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitacoes"
          },
          "versao_motor": {
            "type": "string",
            "title": "Versao Motor"
          },
          "criada_em_utc": {
            "type": "string",
            "title": "Criada Em Utc"
          },
          "fontes_indisponiveis": {
            "items": {
              "$ref": "#/components/schemas/FonteIndisponivel"
            },
            "type": "array",
            "title": "Fontes Indisponiveis"
          },
          "estado_recomendacoes": {
            "type": "string",
            "enum": [
              "simulacao_beta",
              "dados_insuficientes"
            ],
            "title": "Estado Recomendacoes"
          }
        },
        "type": "object",
        "required": [
          "analise_id",
          "eh_mock",
          "descricao_local",
          "talhao",
          "fonte_clima",
          "clima_mensal",
          "estrategias",
          "limitacoes",
          "versao_motor",
          "criada_em_utc",
          "fontes_indisponiveis",
          "estado_recomendacoes"
        ],
        "title": "Analise"
      },
      "AnaliseEntrada": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "origem_local": {
            "type": "string",
            "enum": [
              "gps",
              "municipio"
            ],
            "title": "Origem Local"
          },
          "codigo_ibge": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{7}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codigo Ibge"
          },
          "cultura_atual_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Cultura Atual Id"
          },
          "problemas": {
            "items": {
              "type": "string",
              "enum": [
                "solo_cansado",
                "nematoides_pragas",
                "preco_baixo"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "title": "Problemas"
          },
          "recursos_disponiveis": {
            "$ref": "#/components/schemas/Recursos"
          },
          "prioridades": {
            "items": {
              "type": "string",
              "enum": [
                "uso_agua",
                "valor_forragem",
                "fixacao_nitrogenio",
                "reducao_erosao",
                "materia_organica",
                "adequacao_mercado"
              ]
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 1,
            "title": "Prioridades"
          },
          "correcoes": {
            "$ref": "#/components/schemas/Correcoes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "origem_local",
          "cultura_atual_id",
          "recursos_disponiveis",
          "prioridades"
        ],
        "title": "AnaliseEntrada"
      },
      "AtributosEstrategia": {
        "properties": {
          "protecao_solo": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Protecao Solo"
          },
          "materia_organica": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Materia Organica"
          },
          "fixacao_nitrogenio": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Fixacao Nitrogenio"
          },
          "quebra_pragas": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Quebra Pragas"
          },
          "renda_direta": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Renda Direta"
          },
          "demanda_agua": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Demanda Agua"
          },
          "trabalho_custo": {
            "type": "string",
            "enum": [
              "nenhum",
              "baixo",
              "medio",
              "alto"
            ],
            "title": "Trabalho Custo"
          }
        },
        "type": "object",
        "required": [
          "protecao_solo",
          "materia_organica",
          "fixacao_nitrogenio",
          "quebra_pragas",
          "renda_direta",
          "demanda_agua",
          "trabalho_custo"
        ],
        "title": "AtributosEstrategia"
      },
      "CaracteristicasTalhao": {
        "properties": {
          "textura_solo": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "arenosa",
                  "media",
                  "argilosa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Textura Solo"
          },
          "fonte_textura": {
            "type": "string",
            "enum": [
              "mapas",
              "informado_produtor"
            ],
            "title": "Fonte Textura",
            "default": "mapas"
          },
          "relevo": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "plano",
                  "suave_ondulado",
                  "ondulado"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Relevo"
          },
          "fonte_relevo": {
            "type": "string",
            "enum": [
              "mapas",
              "informado_produtor"
            ],
            "title": "Fonte Relevo",
            "default": "mapas"
          },
          "declividade_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Declividade Pct"
          },
          "risco_erosao": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "nenhum",
                  "baixo",
                  "medio",
                  "alto"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Risco Erosao"
          },
          "risco_seca": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "nenhum",
                  "baixo",
                  "medio",
                  "alto"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Risco Seca"
          },
          "bases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Bases"
          }
        },
        "type": "object",
        "title": "CaracteristicasTalhao"
      },
      "ClimaMensal": {
        "properties": {
          "mes": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Mes"
          },
          "precipitacao_acumulada_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
